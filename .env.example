# 複製這個檔案為 .env 並填入你的設定

# 必填：Discord 機器人 Token
DISCORD_TOKEN=

# 選填：Claude API 金鑰（到 https://console.anthropic.com 申請）
# 沒填的話 /chat 會使用內建的簡易聊天
ANTHROPIC_API_KEY=

# 選填：聊天使用的模型與思考強度（low / medium / high）
# CHAT_MODEL=claude-opus-5-5
# CHAT_EFFORT=low

# 選填：語音朗讀的聲音（edge-tts 的繁中聲音，例如 zh-TW-HsiaoChenNeural、zh-TW-HsiaoYuNeural、zh-TW-YunJheNeural）
# TTS_VOICE=zh-TW-HsiaoChenNeural
